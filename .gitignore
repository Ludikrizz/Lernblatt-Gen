# --- Kursdaten pro Fach ------------------------------------------------------
# Folien, Übungen, Klausuren, Arbeitsdaten und fertige Lernblätter liegen unter
# data/<Fach>/. Sie sind urheberrechtlich geschützt oder reproduzierbar.
# Nur die Strukturbeschreibung bleibt im Repo.
data/*
!data/README.md

# --- Eval-Arbeitsordner (skill-creator), generiert --------------------------
.claude/skills/*-workspace/

# --- Temporäre Skripte und Renderprüfungen ----------------------------------
scratch/*
!scratch/.gitkeep

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Lokale Einstellungen und Logs ------------------------------------------
.claude/settings.local.json
*.log
.env
.env.*

# --- Betriebssystem und Editor ----------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
